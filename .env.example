# Copy this file to .env and fill in real values before running.

PORT=3000

# A long random string — used to sign the login session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Never put a plain-text password here. Generate a hash with:
#   npm run set-password -- "yourPassword"
# then paste the output line below.
ADMIN_PASSWORD_HASH=replace-me

# Set to "production" when deployed behind HTTPS (Render/Railway set this automatically).
NODE_ENV=development
